<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Global NuGet configuration to prevent connection errors.
  This file should be placed in the solution root directory.
  IMPORTANT: This config disables all online package sources to prevent connection errors.
  Packages must be restored manually using: dotnet restore -no-cache
-->
<configuration>
  <packageSources>
    <!-- Clear all default sources to prevent automatic connection attempts -->
    <clear />
    <!-- Only enable NuGet.org if you explicitly need to restore packages -->
    <!-- Uncomment the line below ONLY when you need to restore packages manually -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Disable all external feeds to prevent connection errors -->
    <add key="AvaloniaCI" value="true" />
    <add key="Microsoft Visual Studio Offline Packages" value="false" />
  </disabledPackageSources>
  <packageSourceCredentials>
  </packageSourceCredentials>
  <config>
    <!-- Use local package cache -->
    <add key="repositoryPath" value="packages" />
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
    <!-- Disable automatic package restore during build -->
    <add key="enabled" value="false" />
  </config>
  <packageRestore>
    <!-- Enable automatic package restore -->
    <add key="enabled" value="true" />
    <add key="automatic" value="true" />
  </packageRestore>
  <bindingRedirects>
    <add key="skip" value="True" />
  </bindingRedirects>
</configuration>

