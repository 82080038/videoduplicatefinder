<?xml version="1.0" encoding="utf-8"?>

<!-- 
  To use the Avalonia CI feed to get unstable packages, move this file to the root of your solution.
  Note: MyGet feed is commented out to prevent connection errors. Uncomment if you need CI packages.
-->

<configuration>
  <packageSources>
    <!-- Commented out to prevent connection errors. Uncomment if you need Avalonia CI packages -->
    <!-- <add key="AvaloniaCI" value="https://www.myget.org/F/avalonia-ci/api/v2" /> -->
  </packageSources>
  <disabledPackageSources>
    <!-- Disable MyGet feed to prevent connection attempts -->
    <add key="AvaloniaCI" value="true" />
  </disabledPackageSources>
</configuration>
