<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Disable telemetry to prevent connection errors -->
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- Disable automatic package restore to prevent connection errors -->
    <RestorePackages>true</RestorePackages>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Prevent NuGet from trying to connect -->
    <SkipRestorePackages>false</SkipRestorePackages>
    <!-- Force disable automatic restore in Visual Studio -->
    <RestoreOnBuild>true</RestoreOnBuild>
    <RestoreOnOpen>false</RestoreOnOpen>
    <RestoreOnSave>false</RestoreOnSave>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Disable .NET SDK telemetry -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Prevent NuGet from trying to connect to external feeds -->
    <NuGetPackageRoot>$(UserProfile)\.nuget\packages</NuGetPackageRoot>
    <!-- Disable all network-related build features -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>true</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTargets>x64;arm64</PlatformTargets>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTargets>x64;arm64</PlatformTargets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <AvaloniaResource Include="**\*.xaml">
      <SubType>Designer</SubType>
    </AvaloniaResource>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Remove="Properties\**" />
    <AvaloniaXaml Remove="Properties\**" />
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Styles\Styles.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.0-preview4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.0.0-preview4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0-preview4" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.0.0-preview4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0-preview4" />
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.0.0-preview4" />
    <PackageReference Include="DynamicExpresso.Core" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VDF.Core\VDF.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Update="Styles\Styles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\DatabaseViewer.xaml.cs">
      <DependentUpon>DatabaseViewer.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomSelectionView.xaml.cs">
      <DependentUpon>CustomSelectionView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ThumbnailComparer.xaml.cs">
      <DependentUpon>ThumbnailComparer.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
