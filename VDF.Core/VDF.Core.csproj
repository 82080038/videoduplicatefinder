<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disable automatic package restore to prevent connection errors -->
    <RestorePackages>false</RestorePackages>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Prevent NuGet from trying to connect -->
    <SkipRestorePackages>true</SkipRestorePackages>
    <!-- Force disable automatic restore in Visual Studio -->
    <RestoreOnBuild>false</RestoreOnBuild>
    <RestoreOnOpen>false</RestoreOnOpen>
    <RestoreOnSave>false</RestoreOnSave>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VDF.GUI" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="6.0.0" />
    <PackageReference Include="Mono.Posix.NETStandard" Version="5.20.1-preview" />
    <PackageReference Include="protobuf-net" Version="3.2.16" />
    <PackageReference Include="SixLabors.ImageSharp" Version="1.0.4" />
  </ItemGroup>

</Project>
